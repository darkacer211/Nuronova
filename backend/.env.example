# NeuroNova Environment Variables
PORT=8000

# Optional: Groq API Key for Whisper speech-to-text and LLaMA 3.3 narrative generation
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Google Gemini API Key for narrative generation fallback
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Persistence Configuration (Default: false keeps anonymous client-side mode)
PERSISTENCE_ENABLED=false
PERSISTENCE_BACKEND=supabase # 'supabase' or 'sqlite'

# Supabase Credentials (Required only if PERSISTENCE_BACKEND=supabase and PERSISTENCE_ENABLED=true)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security & Encryption (Master key for AES/HMAC field encryption at rest)
ENCRYPTION_KEY=generate-a-secure-32-byte-hex-key-here
DATA_RETENTION_DAYS=90
